#!/usr/bin/env bash
# ==============================================================================
# AMU-QUANT CLI Launcher (Interactive Terminal Interface)
# ==============================================================================

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -n "$1" ]; then
    MODEL_PATH="$1"
elif [ -f "$DIR/models/Meta-Llama-3-8B-Instruct-Q2_K.gguf" ]; then
    MODEL_PATH="models/Meta-Llama-3-8B-Instruct-Q2_K.gguf"
elif [ -f "$DIR/models/Meta-Llama-3-8B-Instruct-Q3_K_S.gguf" ]; then
    MODEL_PATH="models/Meta-Llama-3-8B-Instruct-Q3_K_S.gguf"
elif [ -f "$DIR/models/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf" ]; then
    MODEL_PATH="models/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf"
elif [ -f "$DIR/models/qwen2.5-3b-instruct-q4_k_m.gguf" ]; then
    MODEL_PATH="models/qwen2.5-3b-instruct-q4_k_m.gguf"
elif [ -f "$DIR/models/qwen2.5-0.5b-instruct-q4_k_m.gguf" ]; then
    MODEL_PATH="models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
else
    FOUND_GGUF=$(find "$DIR/models" -name "*.gguf" 2>/dev/null | head -n 1)
    if [ -n "$FOUND_GGUF" ]; then
        MODEL_PATH="$FOUND_GGUF"
    else
        MODEL_PATH="models/Meta-Llama-3-8B-Instruct-Q2_K.gguf"
    fi
fi

if [ ! -f "$DIR/$MODEL_PATH" ] && [ ! -f "$MODEL_PATH" ]; then
    echo "[ERROR] Model file not found at: $MODEL_PATH"
    echo "Please ensure the model is present in models/ directory."
    exit 1
fi

echo "================================================================================"
echo "  AMU-QUANT: Accelerated On-Device LLM Inference & Memory Compression Engine    "
echo "  Target Model: $MODEL_PATH                                                     "
echo "================================================================================"
echo "Pilih Mode Operasi CLI:"
echo "  [1] AMU-QUANT Chat : Interactive Terminal Chat (AMU-QUANT Engine + turbovec)  "
echo "  [2] Simple API Demo: Run Minimal C++ API Integration Test                      "
echo "  [3] Unit Test Suite: Run CTest Verification (TurboQuant, Controller, Pipeline) "
echo "================================================================================"
read -p "Masukkan pilihan [1-3] (default 1): " CHOICE
CHOICE="${CHOICE:-1}"

case "$CHOICE" in
    1)
        echo -e "\n[INFO] Menjalankan AMU-QUANT Chat CLI..."
        exec "$DIR/build/amuquant_chat" "$MODEL_PATH"
        ;;
    2)
        echo -e "\n[INFO] Menjalankan Minimal API Demo..."
        exec "$DIR/build/simple_inference"
        ;;
    3)
        echo -e "\n[INFO] Menjalankan Unit Test Suite (CTest)..."
        exec ctest --test-dir "$DIR/build" --output-on-failure
        ;;
    *)
        echo "Pilihan tidak valid. Menjalankan AMU-QUANT Chat CLI..."
        exec "$DIR/build/amuquant_chat" "$MODEL_PATH"
        ;;
esac
